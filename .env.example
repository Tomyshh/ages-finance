# ============================================================================
# Variables d'environnement des services backend (api-gateway + mailing).
# Copier en .env (non commité) pour le dev local, ou configurer sur Render.
# ============================================================================

# --- Pennylane (Firm API) ---
# Token Firm (Firm settings > Firm Tokens) : accès à tout le portefeuille de
# dossiers d'AGEC Finances. Scopes recommandés pour la clôture complète :
# customers:readonly, suppliers:readonly, fiscal_years:readonly,
# exports:fec, exports:gl, customer_invoices:readonly, supplier_invoices:readonly.
PENNYLANE_API_KEY=
PENNYLANE_USE_2026_API=true

# --- Resend (envoi du mail) ---
RESEND_API_KEY=
MAIL_FROM=AGEC Finances <onboarding@resend.dev>
MAIL_TO=tom@yapio.io

# --- Secrets internes ---
# Partagé entre api-gateway et mailing (doit être identique des deux côtés).
INTERNAL_SHARED_SECRET=
# Jeton attendu par l'api-gateway de la part du dashboard.
GATEWAY_PUBLIC_TOKEN=

# --- Câblage inter-services (dev local) ---
MAILING_SERVICE_URL=http://localhost:8081
API_GATEWAY_URL=http://localhost:8080

# --- Persistance + stockage (Supabase, optionnel) ---
# Sans ces variables: jobs en mémoire (gateway) et pas de repli lien (mailing).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=clotures

# --- Ports (Render les injecte automatiquement) ---
# PORT=8080
